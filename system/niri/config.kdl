input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:alt_shift_toggle"
        }

        repeat-delay 300
        repeat-rate 30
    }
}

layout {
    gaps 12
    center-focused-column "on-overflow"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width {
        proportion 0.5
    }

    focus-ring {
        width 2
        active-color "#89b4fa"
        inactive-color "#45475a"
    }

    border {
        off
    }
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

// Компоненты сеанса
spawn-at-startup "waybar"
spawn-at-startup "mako"
spawn-at-startup "niri-polkit-agent"
spawn-at-startup "swayidle" "-w"

// История текста и изображений
spawn-at-startup "wl-paste" "--type" "text" "--watch" "cliphist" "store"
spawn-at-startup "wl-paste" "--type" "image" "--watch" "cliphist" "store"

binds {
    // Приложения
    Mod+Return { spawn "alacritty"; }
    Mod+D { spawn "fuzzel"; }
    Mod+E { spawn "nautilus"; }
    Mod+Shift+C { spawn "code"; }
    Mod+B { spawn "firefox"; }

    // Буфер обмена и уведомления
    Mod+V { spawn "niri-clipboard"; }
    Mod+Shift+N { spawn "makoctl" "dismiss" "-a"; }

    // Закрытие окна
    Mod+Q { close-window; }

    // Переключение между окнами
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }

    // Перемещение окон
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }

    // Рабочие столы
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }

    Mod+Shift+Page_Up { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }

    // Размер и положение
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }

    // Объединение окон в колонки
    Mod+BracketLeft { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Скриншоты
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Звук
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "5%+";
    }

    XF86AudioLowerVolume allow-when-locked=true {
        spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-";
    }

    XF86AudioMute allow-when-locked=true {
        spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle";
    }

    // Блокировка и выход
    Mod+L { spawn "swaylock" "-f"; }
    Mod+Shift+E { quit; }

    // Справка
    Mod+Shift+Slash { show-hotkey-overlay; }
}
